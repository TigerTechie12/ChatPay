{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('node_modules/chatpay-db/package.json','utf8'));p.main='generated/prisma/client.ts';fs.writeFileSync('node_modules/chatpay-db/package.json',JSON.stringify(p,null,2))\"",
    "start": "tsx src/index.ts",
    "build": "tsc -b"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "chatpay-db": "^2.256.1",
    "express": "^5.2.1",
    "stripe": "^20.4.1",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.41"
  }
}
